{
  "name": "vantage-stadium",
  "private": true,
  "version": "3.1.0",
  "description": "Vantage : voir depuis n’importe quelle place d’un stade avant d’acheter (démonstrateur 3D, données fictives).",
  "author": "Florian Iglesias",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/Skysaks/VANTAGE-STADIUM"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "build:lab": "VANTAGE_BUILD=lab VANTAGE_OUT=dist/.lab vite build",
    "preview": "vite preview",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
